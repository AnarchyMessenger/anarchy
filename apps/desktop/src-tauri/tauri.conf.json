{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anarchy",
  "version": "0.0.1",
  "identifier": "org.anarchymessenger.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Anarchy",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "label": "main",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
